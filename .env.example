# Copy this file to ".env" and fill in your own values. NEVER commit ".env".

# --- Core ---
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
# True for local development, False in production
DJANGO_DEBUG=True
# Comma-separated hostnames, e.g. localhost,127.0.0.1,www.yourdomain.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, including scheme, e.g. https://www.yourdomain.com (needed in production)
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database ---
# Leave empty to use local SQLite. For PostgreSQL use:
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# --- Email notifications for contact form ---
# Development: prints emails to the terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production (SMTP) example:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=KrisCodeSolutions <no-reply@example.com>
# Where new-inquiry notifications are sent. Leave empty to disable notifications.
CONTACT_NOTIFY_EMAIL=chimanmecha202@gmail.com

# --- Production hardening (only used when DJANGO_DEBUG=False) ---
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=3600
# Set True only if your host cannot serve /media/ files any other way
DJANGO_SERVE_MEDIA=False
